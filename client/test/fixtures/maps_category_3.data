,[367,368],-77.680362,43.083606,-77.680043,43.08361,-77.68004,43.083713,-77.679979,43.083714,43.083577,-77.679916,43.083503,-77.67985,43.083506,-77.679842,43.083365,-77.679942,43.083345,-77.680004,43.083315,-77.680046,43.083275,-77.680064,43.083228,-77.680075,43.083191,-77.680378,43.083184,-77.680391,43.083495,-77.680359,43.083499,195,50,"University Services Center","In 2010, University Services Center was the first building in Monroe County to earn a LEED Platinum rating. Among the sustainability attributes of the building are: a 12.2 KW solar array on the roof and shower and locker facilities for cyclists. A third of the materials used in the building contain recycled content and a quarter of the materials were sourced within a 500 mile radius.","USC","087",[405],{"_81":400,"_82":406,"_43":399,"_83":398},"https://maps.rit.edu/pictures/087_usc.jpeg",63,"Admin Building",5,{"_41":908,"_45":909,"_30":335,"_336":-5,"_337":-5,"_338":910,"_340":341,"_342":341},[412,413,414,415,416,417,418,419,420],{"_30":31,"_32":851,"_34":852},{"_30":31,"_32":828,"_34":829},{"_30":31,"_32":722,"_34":723},{"_30":31,"_32":683,"_34":684},{"_30":31,"_32":640,"_34":641},{"_30":31,"_32":600,"_34":601},{"_30":31,"_32":543,"_34":544},{"_30":31,"_32":495,"_34":496},{"_30":31,"_32":421,"_34":422},{"_41":480,"_43":481,"_45":482,"_47":483,"_49":484,"_51":52,"_53":480,"_55":485,"_486":487,"_488":489,"_490":491},{"_30":86,"_37":423},[424],[425,426,427,428,429,430,431,432,433,434,435,436,437,438,439,440,441,442,443,444,445,446,447,448,449],[450,374],[478,479],[478,477],[476,477],[476,475],[473,475],[473,474],[470,472],[470,471],[468,469],[468,467],[466,467],[466,465],[464,465],[464,463],[462,463],[461,460],[459,460],[458,457],[455,457],[455,456],[453,454],[453,452],[451,452],[450,374],-77.681947,-77.681946,43.083652,-77.681954,43.083635,-77.681923,43.083636,43.08356,-77.682089,-77.682088,43.08329,-77.681908,-77.681909,43.083219,-77.681928,43.083129,-77.682124,43.08312,-77.682184,43.083141,-77.68234,43.08314,43.083706,-77.682219,43.083707,43.083697,-77.682188,43.083724,-77.681992,43.083715,5543,2383,"Global Village Way E","GVE","405",[],"Floors",[494],"Air conditioning",[493],"URL",[492],"global-village","TRUE","4",{"_41":534,"_43":535,"_45":536,"_67":537,"_47":538,"_49":539,"_51":52,"_53":534,"_55":540},{"_30":86,"_37":497},[498],[499,500,501,502,503,504,505,506,507,508,509,510,511],[512,513],[532,533],[530,531],[528,529],[526,527],[524,525],[522,523],[521,520],[519,520],[517,518],[515,516],[514,513],[512,513],-77.66945,43.086333,-77.669357,-77.669359,43.086243,-77.669258,43.086241,-77.66926,43.085672,-77.669333,-77.669337,43.085625,-77.669551,43.085623,-77.669545,43.086092,-77.669593,43.086087,-77.669588,43.086204,-77.669452,43.08621,2567,685,"Rosica Hall","This LEED Gold facility boasts extensive natural day lighting, five commissioned works of art and a meditation garden. More information about the green features of this building can be found at: http://buildingdashboard.net/rit/#/rit/rosica","RSC","053",[541],{"_81":536,"_82":542,"_43":535,"_83":534},"https://maps.rit.edu/pictures/053_rsc.jpg",{"_41":591,"_43":592,"_45":593,"_67":594,"_47":595,"_49":596,"_51":52,"_53":591,"_55":597},{"_30":86,"_37":545},[546],[547,548,549,550,551,552,553,554,555,556,557,558,559,560,561,562],[563,564],[589,590],[587,588],[585,586],[583,584],[581,582],[579,580],[577,578],[572,576],[574,575],[572,573],[571,570],[569,570],[567,568],[565,566],[563,564],-77.679031,43.085583,-77.678932,43.085543,-77.678928,43.085525,-77.678825,43.085528,-77.67878,-77.678781,43.085488,-77.678832,43.085486,43.085459,-77.678769,43.085113,-77.679041,43.085109,-77.679043,43.085136,-77.679208,43.085133,-77.679224,43.085626,-77.679184,43.085629,-77.679133,43.08562,2563,684,"Institute Hall","LEED Gold facility, Institute Hall is home to the University's new green data center. The building envelop was designed to maximize energy efficiency and a large rain garden runs along the east side of the building and features native and adapted plant species.","INS","073",[598],{"_81":593,"_82":599,"_43":592,"_83":591},"https://maps.rit.edu/pictures/073_ins.jpg",{"_41":631,"_43":632,"_45":633,"_67":634,"_47":635,"_49":636,"_51":52,"_53":631,"_55":637},{"_30":86,"_37":602},[603],[604,605,606,607,608,609,610,611,612,613,614],[615,616],[628,630],[628,629],[626,627],[625,624],[622,624],[622,623],[620,621],[619,305],[617,618],[615,616],-77.680795,43.085529,-77.680792,43.085269,-77.68094,-77.680939,43.085179,-77.681675,43.085164,43.085252,-77.681805,-77.681804,43.08542,-77.681591,43.085423,43.085521,2559,682,"Sustainability Institute Hall","Sustainability Institute Hall is home to RIT's Golisano Institute for Sustainability (GIS). LEED-Platinum certified, the building is powered by an array of alternative energy sources, including hydrogen, solar, wind, and geothermal power. It features 75,000 square feet of laboratory and testing facilities, as well as several interactive classrooms, an auditorium, a three-story green wall, and a breath-taking view from its green rooftop, a habitat for Monarch butterflies.","SUS","081",[638],{"_81":633,"_82":639,"_43":632,"_83":631},"https://maps.rit.edu/pictures/081_sus.jpg",{"_41":671,"_43":672,"_45":673,"_67":674,"_47":675,"_49":676,"_51":52,"_53":671,"_55":677,"_486":678,"_490":679,"_488":680},{"_30":86,"_37":642},[643],[644,645,646,647,648,649,650,651,652,653,654],[655,656],[669,670],[668,662],[667,660],[665,666],[663,664],[661,662],[658,660],[658,659],[655,657],[655,656],-77.68158,43.082937,43.08284,-77.681605,43.082839,43.082817,-77.681626,43.082815,-77.681628,43.082786,-77.682352,43.08278,-77.682354,-77.682392,-77.682394,43.082931,227,65,"Global Village Way D","The mixed use Global Village project earned LEED Gold in 2012. The most notable green feature of the project is an intensive green roof located above The Cantina that provides attractive views from rooms above as well as increased habitat and improved stormwater quality.","GVD","404",