#!/usr/bin/env bash
# Desktop launcher: build a new release if the source changed, then start the current one.
# Installed as a copy by scripts/install-desktop --launcher, so it outlives any worktree.
# The app always runs from a complete copy under releases/, never from the build dir.
# TIGERHUB_NO_REBUILD=1 just starts the current release.
set -uo pipefail

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/tigerhub"
STAMP="$STATE/build-stamp"
LOG="$STATE/build.log"
REL="$STATE/releases"
CUR="$STATE/current"

notify() {
  command -v notify-send >/dev/null && notify-send -a TigerHub -i dev.colewiz.tigerhub "$@" || true
}

# say why a rebuild was skipped, then carry on with the current release
skip() {
  printf '%s %s\n' "$(date +%FT%T)" "$1" >> "$STATE/launcher.log"
  notify -u critical "TigerHub not updated" "$1"
}

# head plus a hash of tracked diffs and untracked files under client/
source_state() {
  local head diff untracked
  head="$(git -C "$SRC" rev-parse HEAD)" || return 1
  diff="$(git -C "$SRC" diff HEAD -- client | sha256sum)" || return 1
  untracked="$(git -C "$SRC" ls-files -o --exclude-standard -z -- client | (cd "$SRC" && xargs -0 -r sha256sum) | sha256sum)" || return 1
  printf '%s\n%s\n%s\n' "$head" "$diff" "$untracked"
}

verify_bundle() {
  [ -x "$1/tigerhub" ] && [ -s "$1/tigerhub" ] && [ -d "$1/lib" ] && [ -d "$1/data" ]
}

# copy a bundle into releases/, check it, then point current at it
publish() {
  local id tmp
  id="$(date +%s)-$(printf '%s' "$1" | sha256sum | cut -c1-8)"
  tmp="$REL/$id.tmp"
  mkdir -p "$REL"
  rm -rf "$tmp"
  if ! cp -a "$BIN_DIR" "$tmp" || ! verify_bundle "$tmp" || ! mv -T "$tmp" "$REL/$id"; then
    rm -rf "$tmp"
    return 1
  fi
  touch "$REL/$id"
  rm -f "$CUR.tmp"
  ln -s "$REL/$id" "$CUR.tmp" && mv -T "$CUR.tmp" "$CUR"
}

# keep the newest two, and never what current points at
prune() {
  local live name n=0
  live="$(readlink -f "$CUR")"
  for name in $(ls -1t "$REL"); do
    n=$((n + 1))
    [ "$n" -gt 2 ] && [ "$REL/$name" != "$live" ] && rm -rf "${REL:?}/$name"
  done
}

rebuild_if_changed() {
  local now
  rm -rf "$REL"/*.tmp "$CUR.tmp" "$STATE"/previous "$STATE"/previous.tmp "$STATE"/previous.old
  now="$(source_state)" || { skip "git failed in $SRC, starting the current release"; return 0; }
  if [ ! -x "$CUR/tigerhub" ] && verify_bundle "$BIN_DIR"; then
    publish seed || skip "could not copy the existing build into a release"
  fi
  [ -x "$CUR/tigerhub" ] && [ "$(cat "$STAMP" 2>/dev/null)" = "$now" ] && return 0
  notify "Updating TigerHub" "Building the latest version, this can take a minute"
  if ! "$SRC/scripts/dev" build >"$LOG" 2>&1 9>&-; then
    skip "build failed, starting the current release. Log: $LOG"
  elif ! verify_bundle "$BIN_DIR" || ! publish "$now"; then
    skip "build finished but could not be released, starting the current release"
  else
    printf '%s\n' "$now" >"$STAMP"
    prune
  fi
}

# last resort with no release: the source tree build, only if nobody is building
run_source_build() {
  if command -v flock >/dev/null && { ! exec 9>"$STATE/lock" || ! flock -n 9; }; then
    notify -u critical "TigerHub is updating" "No version is ready yet. Try again in a minute"
    exit 1
  fi
  verify_bundle "$BIN_DIR" || return 0
  notify -u critical "TigerHub" "Running the build folder directly, no release exists"
  exec "$BIN_DIR/tigerhub" "$@" 9>&-
}

mkdir -p "$STATE"
SRC="${TIGERHUB_SRC:-}"
[ -n "$SRC" ] || { IFS= read -r -d '' SRC < "$STATE/src"; } 2>/dev/null || SRC=""
BIN_DIR="$SRC/client/build/linux/x64/release/bundle"

if [ "${TIGERHUB_NO_REBUILD:-}" != 1 ]; then
  git_dir="$(git -C "$SRC" rev-parse --absolute-git-dir 2>/dev/null)"
  common_dir="$(cd "$SRC" 2>/dev/null && cd "$(git rev-parse --git-common-dir 2>/dev/null)" 2>/dev/null && pwd -P)"
  if [ -z "$SRC" ] || [ -z "$git_dir" ] || [ "$git_dir" != "$common_dir" ]; then
    skip "no main checkout at '$SRC', run scripts/install-desktop --launcher"
  elif ! command -v flock >/dev/null; then
    skip "flock not found, not rebuilding"
  elif ! exec 9>"$STATE/lock"; then
    skip "could not open the build lock, not rebuilding"
  elif flock -n 9; then
    rebuild_if_changed
  else
    notify "TigerHub is updating" "Another launch is building, using the current version"
  fi
fi

exec 9>&-
[ -x "$CUR/tigerhub" ] && exec "$CUR/tigerhub" "$@"
run_source_build "$@"
notify -u critical "TigerHub cannot start" "No usable build found. Log: $LOG"
exit 1
