#!/usr/bin/env bash
# TigerHub dev helper. Run `scripts/dev help` for the list.
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CLIENT="$ROOT/client"
BIN="$CLIENT/build/linux/x64/release/bundle/tigerhub"
FLUTTER="${FLUTTER:-$HOME/flutter/bin/flutter}"

# Where the app keeps its scraped snapshots. Matches getApplicationSupportDirectory
# for the dev.colewiz.tigerhub application id.
DATA="${XDG_DATA_HOME:-$HOME/.local/share}/dev.colewiz.tigerhub/data"

# Colours, dropped when not a terminal.
if [ -t 1 ]; then
  B=$'\e[1m'; DIM=$'\e[2m'; G=$'\e[32m'; Y=$'\e[33m'; R=$'\e[31m'; N=$'\e[0m'
else
  B=""; DIM=""; G=""; Y=""; R=""; N=""
fi
say()  { printf '%s==>%s %s\n' "$B" "$N" "$*"; }
ok()   { printf '%s  ok%s %s\n' "$G" "$N" "$*"; }
warn() { printf '%s  !!%s %s\n' "$Y" "$N" "$*"; }
die()  { printf '%s error%s %s\n' "$R" "$N" "$*" >&2; exit 1; }

# ---------------------------------------------------------------- commands

cmd_status() {
  pgrep -x tigerhub >/dev/null && ok "app running" || warn "app not running"
  echo
  cmd_data
}

# What the app has actually scraped and stored, which is the closest thing to
# the old /health/sources now that there is no server to ask.
cmd_data() {
  [ -d "$DATA" ] || { warn "no snapshots yet at $DATA"; return 0; }
  local found=0
  for f in "$DATA"/*.json; do
    [ -e "$f" ] || continue
    found=1
    local name age size
    name="$(basename "$f" .json)"
    size="$(du -h "$f" | cut -f1)"
    age="$(python3 -c "
import os,sys,time
m=os.path.getmtime(sys.argv[1]); d=int(time.time()-m)
print('%dh %dm ago' % (d//3600, (d%3600)//60) if d>=3600 else '%dm ago' % (d//60))
" "$f")"
    printf '  %-24s %6s  %s\n' "$name" "$size" "$age"
  done
  [ "$found" = 1 ] || warn "no snapshots yet"
}

cmd_app() {
  if [ "${1:-}" = "--dev" ]; then
    say "flutter run (hot reload)"
    ( cd "$CLIENT" && "$FLUTTER" run -d linux "${@:2}" )
  else
    [ -x "$BIN" ] || die "no release build. Run: scripts/dev build"
    say "launching the release build"
    "$BIN" "$@"
  fi
}

cmd_build() {
  say "building linux"
  ( cd "$CLIENT" && "$FLUTTER" build linux --release ) || die "linux build failed"
  ok "linux built"
}

cmd_test() {
  say "analyze"
  ( cd "$CLIENT" && "$FLUTTER" analyze ) || die "analyze failed"
  say "tests"
  ( cd "$CLIENT" && "$FLUTTER" test ) || die "tests failed"
  ok "all green"
}

cmd_reset() {
  pgrep -x tigerhub >/dev/null && die "close the app first"
  rm -rf "$DATA"
  ok "snapshots wiped, the next launch scrapes from scratch"
}

# Screenshot just the app window.
#
# This crops to the window geometry rather than grabbing the whole screen, so a
# capture can never contain Cole's browser, terminal, or lock screen. That also
# removes any dependence on workspace switching, which matters because
# `hyprctl dispatch` is broken on this Hyprland build (see CLAUDE.md 2.1).
# Refuse unless the TigerHub window is the focused one.
#
# grim captures the screen at a set of coordinates, not a window's own buffer,
# so anything drawn over the app is what lands in the file. Cropping to the
# window rules out grabbing the wrong region and nothing else. This has already
# captured a lock screen once and a notification panel full of messages once.
#
# Compositor overlays are layer-shell surfaces: they never appear in
# `hyprctl clients`, and the ones here are full screen and permanently mapped,
# so their geometry cannot tell you whether they are currently drawn. Requiring
# focus is the check that actually works, because a drawer or a lock screen
# takes focus away from the app.
#
# The cost is that captures are no longer automatic. That is the right trade.
require_focus() {
  local active
  active="$(hyprctl activewindow -j 2>/dev/null \
    | python3 -c 'import json,sys; print((json.load(sys.stdin) or {}).get("class",""))' 2>/dev/null)"
  [ "$active" = "dev.colewiz.tigerhub" ] && return 0
  warn "focus is on: ${active:-nothing}"
  die "click the TigerHub window first. Captures are refused when it is not focused, because grim would record whatever is on top of it."
}

cmd_shot() {
  command -v hyprctl >/dev/null || die "hyprctl not found, this is Hyprland only"
  command -v grim >/dev/null || die "grim not found"
  [ -x "$BIN" ] || die "no release build. Run: scripts/dev build"

  local out="${1:-/tmp/tigerhub.png}"
  local started=0

  if ! pgrep -x tigerhub >/dev/null; then
    say "launching the app"
    ( "$BIN" >/dev/null 2>&1 & )
    started=1
    local i=0
    # Wait by window CLASS, which is dev.colewiz.tigerhub, not tigerhub.
    until hyprctl clients -j | grep -q 'dev.colewiz.tigerhub'; do
      i=$((i+1))
      [ "$i" -gt 25 ] && die "window never appeared"
      sleep 1
    done
    sleep 6
  fi

  require_focus

  local geo
  geo="$(hyprctl clients -j | python3 "$ROOT/scripts/_geometry.py")" \
    || die "not safe to capture, see above"

  grim -g "$geo" "$out" || die "grim failed"
  ok "wrote $out ($geo)"

  if [ "$started" = "1" ]; then
    pkill -x tigerhub 2>/dev/null
    ok "closed the app"
  else
    say "left the already running app open"
  fi
}

# Capture every tab into response/screenshots/.
#
# Tabs are driven with wtype on the digit shortcuts, because hyprctl dispatch
# cannot be used here (see CLAUDE.md 2.1). Each frame is cropped to the window,
# so a capture never contains anything but the app.
cmd_shot_tabs() {
  command -v wtype >/dev/null || die "wtype not found, needed to switch tabs"
  command -v grim >/dev/null || die "grim not found"
  [ -x "$BIN" ] || die "no release build. Run: scripts/dev build"

  local dir="$ROOT/response/screenshots"
  mkdir -p "$dir"

  local started=0
  if ! pgrep -x tigerhub >/dev/null; then
    ( "$BIN" >/dev/null 2>&1 & )
    started=1
    local i=0
    until hyprctl clients -j | grep -q 'dev.colewiz.tigerhub'; do
      i=$((i+1)); [ "$i" -gt 25 ] && die "window never appeared"; sleep 1
    done
    sleep 8
  fi

  # wtype sends keystrokes to whatever holds focus, not to a chosen window, so
  # an unfocused app means typing "1234" into someone's terminal or chat.
  require_focus

  local geo
  geo="$(hyprctl clients -j | python3 "$ROOT/scripts/_geometry.py")" \
    || die "not safe to capture, see above"

  local pair key name failed=0
  for pair in "1:01-today" "2:02-dining" "3:03-events" "4:04-campus"; do
    key="${pair%%:*}"; name="${pair##*:}"
    wtype "$key"; sleep 2
    grim -g "$geo" "$dir/$name.png" || { warn "grim failed for $name"; failed=1; continue; }
    ok "$name.png"
  done

  # Leave it on the first tab rather than wherever the loop finished.
  wtype 1

  if [ "$started" = "1" ]; then
    pkill -x tigerhub 2>/dev/null
    ok "closed the app"
  fi

  [ "$failed" = "0" ] || die "some captures were discarded, see above"
  say "written to response/screenshots/"
}


cmd_help() {
  cat <<'HELP'
TigerHub dev helper

There is no backend. The app scrapes RIT itself, so there is nothing to
start, nothing to wait for, and no port.

  scripts/dev app          launch the built app
  scripts/dev app --dev    flutter run instead, with hot reload

  scripts/dev status       is the app running, and what has it scraped
  scripts/dev data         what is cached on disk, and how old it is
  scripts/dev reset        wipe the snapshots, next launch scrapes fresh

  scripts/dev build        build the linux release
  scripts/dev install      add a desktop entry and icons for launchers
  scripts/dev test         flutter analyze plus flutter test
  scripts/dev shot [file]  screenshot the app window, if it is focused
  scripts/dev shot-tabs    capture every tab, if the app is focused

Both refuse unless the TigerHub window has focus. grim records the screen at
a set of coordinates, so anything drawn over the app lands in the file, and
compositor overlays cannot be detected any other way.

Environment:
  FLUTTER=~/flutter/bin/flutter
HELP
}

case "${1:-help}" in
  status|st) shift; cmd_status "$@" ;;
  app|run) shift; cmd_app "$@" ;;
  build) shift; cmd_build "$@" ;;
  install) shift; "$ROOT/scripts/install-desktop" "$@" ;;
  test) shift; cmd_test "$@" ;;
  data) shift; cmd_data "$@" ;;
  shot|screenshot) shift; cmd_shot "$@" ;;
  shot-tabs|tabs) shift; cmd_shot_tabs "$@" ;;
  reset) shift; cmd_reset "$@" ;;
  help|-h|--help) cmd_help ;;
  *) printf 'unknown command: %s\n\n' "$1"; cmd_help; exit 1 ;;
esac
